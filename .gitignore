# ---- Secrets and local credentials ----
# Never commit these. .env.local carried a live dev-auth bypass secret once already.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
service-account*.json
application_default_credentials.json
oauth2-proxy.cfg.yaml
oauth2-proxy.exe
oauth2-proxy

# ---- Node / frontend ----
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local
coverage/
.eslintcache
*.tsbuildinfo

# ---- Python / backend ----
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

