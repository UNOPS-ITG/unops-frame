{
  "name": "frame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A governed work platform: a Smartsheet-grade grid over metadata-defined Blueprints.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n infra,api,web -c blue,magenta,green \"npm:dev:infra\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:infra": "docker compose up",
    "dev:api": "node scripts/start-backend.mjs",
    "dev:web": "vite",
    "dev:docker": "docker compose --profile containerized up",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v",
    "build": "tsc -b && npm run check:locales && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run src",
    "test:watch": "vitest",
    "fitness": "vitest run tools/fitness",
    "perf": "playwright test --project=perf",
    "e2e": "playwright test --project=e2e",
    "demo:m1": "node tools/demo/split-screen.mjs .artifacts",
    "seed": "node scripts/seed-dev-register.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:indexes": "node scripts/check-firestore-indexes.mjs",
    "check:ports": "node scripts/check-ports.mjs",
    "ports": "node -e \"import('./config/ports.mjs').then(m=>console.log(JSON.stringify(m.ports,null,2)))\"",
    "verify": "npm run check:ports && npm run lint && npm run typecheck && npm run fitness && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@glideapps/glide-data-grid": "^6.0.4-alpha24",
    "@tanstack/react-query": "^5.101.4",
    "lodash": "^4.18.1",
    "marked": "^16.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-responsive-carousel": "^3.2.23",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
