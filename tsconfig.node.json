{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    // DOM is here for the Playwright specs only. Their `page.evaluate`
    // callbacks are serialised and run INSIDE the browser, so they legitimately
    // reference `document` and `HTMLCanvasElement` from a file that otherwise
    // runs in Node. Without it the canvas assertions cannot be written at all —
    // and those are the only proof the grid paints anything.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "tools/**/*.ts", "config/*.d.mts"]
}
