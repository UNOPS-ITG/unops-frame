rules_version = '2';

// Frame denies everything at the rules layer, deliberately and permanently.
//
// Every read and write goes through the API, which evaluates access with the
// single permission library (PM-4). Firestore security rules are NOT a
// permission surface here and must never become one: they cannot express
// parent-child permission composition (PM-3), they cannot render the typed
// restricted stubs the transparency principle requires (PM-5), and expressing
// row-condition ABAC in a second language is precisely the second
// implementation PM-4 forbids.
//
// It follows that no client ever holds a Firestore listener on row data.
// Real-time reaches the browser through server-mediated rooms whose
// subscription is itself an evaluated permission decision (GR-8).
//
// If you are here because a client read failed: that is this file working.
// Add an API endpoint, not a rule.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
