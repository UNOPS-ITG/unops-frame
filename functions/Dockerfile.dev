# syntax=docker/dockerfile:1.7
#
# Development image only. Source is NOT copied in — it arrives via the bind mount at
# runtime, so a save on the host is visible immediately (with WATCHFILES_FORCE_POLLING,
# because Windows and macOS bind mounts do not propagate inotify events into Linux).
#
# Pinned to 3.12 to match the estate, even though the host here has 3.13: the container is
# the reproducible environment, and it should be the one the estate standardises on.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml ./

# Dependencies are read out of pyproject.toml so there is exactly ONE dependency list. A
# second requirements.txt is how the two drift, and the drift is only noticed when a
# container behaves differently from a laptop.
RUN python - <<'PY' > /tmp/requirements.txt
import tomllib
project = tomllib.load(open("pyproject.toml", "rb"))["project"]
deps = project["dependencies"] + project.get("optional-dependencies", {}).get("dev", [])
print("\n".join(deps))
PY
RUN pip install -r /tmp/requirements.txt

EXPOSE 6301

CMD ["python", "-m", "uvicorn", "api.cloudrun:app", \
     "--host", "0.0.0.0", "--port", "6301", "--reload", \
     "--reload-dir", "/app/api", \
     "--reload-dir", "/app/lib", \
     "--reload-dir", "/app/consumers", \
     "--reload-dir", "/app/migrations"]
