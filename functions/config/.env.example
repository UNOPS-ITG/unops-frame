# Frame backend configuration. Copy to config/.env (gitignored) and fill in.
#
# config/.env is per-developer and never committed. The dev auth bypass secret
# in particular is a real authentication bypass, gated to LOCAL only.

ENVIRONMENT=local
GCP_PROJECT_ID=unops-frame-dev
FIRESTORE_DATABASE_ID=frame

# The audience the signed identity assertion must carry.
# LOCAL: the Google OAuth client id that oauth2-proxy is configured with.
# DEPLOYED: the IAP backend-service audience string.
# There is no default — an empty audience would disable validation, so the
# service refuses to start without it.
IAP_AUDIENCE=
# LOCAL: https://accounts.google.com and Google's OAuth certs.
# DEPLOYED: leave unset to use the Cloud IAP defaults.
IAP_ISSUER=https://accounts.google.com
IAP_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

IDENTITY_HOSTED_DOMAIN=unops.org

# Emulators. Host:port, no scheme. Set by scripts/start-backend.mjs from
# config/ports.json; only needed here if running the backend by hand.
FIRESTORE_EMULATOR_HOST=127.0.0.1:6310
PUBSUB_EMULATOR_HOST=127.0.0.1:6314
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:6311
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:6313

# Local-only auth bypass, for headless tooling that cannot complete an
# interactive consent screen. Leave DEV_AUTH_BYPASS_SECRET empty to disable.
# The allowlist is deliberate: a request header must not be able to impersonate
# an arbitrary address, even locally, because these runs write to the same
# audit shape as everything else.
DEV_AUTH_BYPASS_SECRET=
DEV_AUTH_BYPASS_DEFAULT_EMAIL=
DEV_AUTH_BYPASS_ALLOWED_EMAILS=["dev@unops.org"]

LOG_LEVEL=INFO
